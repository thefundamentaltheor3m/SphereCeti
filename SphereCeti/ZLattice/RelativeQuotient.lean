module

public import Mathlib.Algebra.Module.ZLattice.Covolume

/-!
# The quotient of a full lattice by a full sublattice

For full lattices `Λ ≤ Γ` in a finite-dimensional real inner product space, the quotient `Γ / Λ` is
finite: by Mathlib's covolume formula, its order is the ratio `covol(Λ) / covol(Γ)` of positive
covolumes.  The inclusion `Λ ≤ Γ` cannot be dropped: `ℤ` and `√2 ℤ` are full lattices in `ℝ`
with trivial intersection.

In the uniqueness argument of Cohn and Elkies, `Λ` is the period lattice of an optimal periodic
packing and `Γ` is the lattice generated by its translated centers; the center orbits embed into
the finite quotient `Γ / Λ`.  The results here are general lattice theory, stated in the form
intended for Mathlib's covolume API (`UPSTREAM.md`, item A15).

## Main definitions

* `SphereCeti.ZLattice.RelativeQuotient Λ Γ`: the quotient of `Γ` by its subgroup `Λ`.

## Main statements

* `SphereCeti.ZLattice.finite_relativeQuotient`: the quotient of a full lattice by a full
  sublattice is finite.
-/

public section

open MeasureTheory

namespace SphereCeti.ZLattice

/-- The quotient of an additive lattice `Γ` by the subgroup `Λ ⊓ Γ` cut out by a lattice `Λ`. -/
abbrev RelativeQuotient {E : Type*} [AddCommGroup E] (Λ Γ : Submodule ℤ E) :=
  Γ.toAddSubgroup ⧸ Λ.toAddSubgroup.addSubgroupOf Γ.toAddSubgroup

/-- The quotient of a full lattice by a full sublattice is finite. -/
theorem finite_relativeQuotient {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    [FiniteDimensional ℝ E] {Λ Γ : Submodule ℤ E} [DiscreteTopology Λ] [IsZLattice ℝ Λ]
    [DiscreteTopology Γ] [IsZLattice ℝ Γ] (hle : Λ ≤ Γ) : Finite (RelativeQuotient Λ Γ) := by
  borelize E
  rw [RelativeQuotient, ← AddSubgroup.index_ne_zero_iff_finite]
  -- The relative index is the ratio of the two positive covolumes.
  have h := ZLattice.covolume_div_covolume_eq_relIndex' Λ Γ hle
  have hpos : 0 < ZLattice.covolume Λ / ZLattice.covolume Γ :=
    div_pos (ZLattice.covolume_pos Λ volume) (ZLattice.covolume_pos Γ volume)
  rw [h] at hpos
  exact (Nat.cast_pos.mp hpos).ne'

end SphereCeti.ZLattice
