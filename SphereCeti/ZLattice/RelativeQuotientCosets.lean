module

public import SphereCeti.ZLattice.RelativeQuotientEmbedding

/-!
# Points meeting every coset of a subgroup

Let `Λ` and `Γ` be subgroups of an additive group `E`, and let `p : ι → E` be a nonempty finite
family of points, pairwise incongruent modulo `Λ`, whose translates `p q - x₀` lie in `Γ`.  If
their number equals the index of `Λ ⊓ Γ` in `Γ`, then the translates meet every coset: every
`γ ∈ Γ` differs from some `p q - x₀` by a vector of `Λ`.

In the uniqueness argument of Cohn and Elkies, the points are representatives of the center
orbits of an optimal periodic packing with period lattice `Λ`, and `Γ` is the lattice generated by
the translated centers.  Equality of the number of orbits with the index then says that the
translated centers are all of `Γ`, and then the separation of the packing bounds below the norm of
every nonzero vector of `Γ`.

## Main statements

* `SphereCeti.ZLattice.exists_sub_mem_of_relIndex_eq_card`: when the number of points equals the
  index, every vector of `Γ` is congruent modulo `Λ` to a translated point.
* `SphereCeti.ZLattice.le_norm_of_image_sub_eq`: if the translates of an `r`-separated set are
  exactly `Γ`, every nonzero vector of `Γ` has norm at least `r`.

## References

* H. Cohn and N. Elkies, *New upper bounds on sphere packings I*, Annals of Mathematics 157
  (2003), 689–714, Section 8.
-/

public section

namespace SphereCeti.ZLattice

/-- Let `Λ` and `Γ` be subgroups of an additive group, and let `p` be a nonempty finite family of
points, pairwise incongruent modulo `Λ`, whose translates `p q - x₀` lie in `Γ`.  If the index of
`Λ ⊓ Γ` in `Γ` equals the number of points, then every `γ ∈ Γ` is congruent modulo `Λ` to some
translate `p q - x₀`. -/
theorem exists_sub_mem_of_relIndex_eq_card {E : Type*} [AddCommGroup E] {Λ Γ : Submodule ℤ E}
    {ι : Type*} [Fintype ι] [Nonempty ι] {p : ι → E} {x₀ : E} (hΓ : ∀ q, p q - x₀ ∈ Γ)
    (hp : ∀ q q', p q - p q' ∈ Λ → q = q')
    (hcard : Λ.toAddSubgroup.relIndex Γ.toAddSubgroup = Fintype.card ι) {γ : E} (hγ : γ ∈ Γ) :
    ∃ q, γ - (p q - x₀) ∈ Λ := by
  -- The quotient `Γ / Λ` is finite, of the same cardinality as the points, so the embedding of
  -- the points into it is onto.
  have : Finite (RelativeQuotient Λ Γ) :=
    AddSubgroup.index_ne_zero_iff_finite.mp (hcard.trans_ne Fintype.card_ne_zero)
  have hbij := (relativeQuotientEmbedding hΓ hp).injective.bijective_of_nat_card_le
    (le_of_eq (hcard.trans Nat.card_eq_fintype_card.symm))
  obtain ⟨q, hq⟩ := hbij.2 (QuotientAddGroup.mk (⟨γ, hγ⟩ : Γ.toAddSubgroup))
  rw [relativeQuotientEmbedding_apply, QuotientAddGroup.eq, AddSubgroup.mem_addSubgroupOf] at hq
  exact ⟨q, by simpa [neg_add_eq_sub] using hq⟩

/-- If the translates `x - x₀` of the points of a set `X`, with `x₀ ∈ X`, are exactly the vectors
of `Γ`, and distinct points of `X` are at distance at least `r`, then every nonzero vector of `Γ`
has norm at least `r`. -/
theorem le_norm_of_image_sub_eq {E : Type*} [SeminormedAddCommGroup E] {Γ : Submodule ℤ E}
    {X : Set E} {x₀ : E} {r : ℝ} (hx₀ : x₀ ∈ X)
    (hsep : ∀ x ∈ X, ∀ y ∈ X, x ≠ y → r ≤ dist x y)
    (hX : (fun x ↦ x - x₀) '' X = (Γ : Set E)) (γ : Γ) (hγ : γ ≠ 0) : r ≤ ‖(γ : E)‖ := by
  obtain ⟨x, hx, hxγ⟩ := (Set.ext_iff.mp hX γ).mpr γ.2
  rw [← hxγ, ← dist_eq_norm]
  exact hsep x hx x₀ hx₀ fun h ↦ hγ (Submodule.coe_eq_zero.mp (by simpa [h] using hxγ.symm))

end SphereCeti.ZLattice
