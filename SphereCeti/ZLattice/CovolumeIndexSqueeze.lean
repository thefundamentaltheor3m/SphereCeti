module

public import SphereCeti.ZLattice.CovolumeBound

/-!
# The covolume/index squeeze

Let `L ≤ Γ` be full lattices in a finite-dimensional real inner product space, with `Γ` integral.
If `L` has covolume `N` and index at least `N` in `Γ`, then `Γ` has covolume exactly one and `L`
has index exactly `N` in `Γ`.

In the uniqueness argument of Cohn and Elkies, `L` is the period lattice of an optimal periodic
packing with `N` center orbits and one center per unit volume, so that `covol(L) = N`; `Γ` is the
even lattice generated by the translated centers, into whose quotient by `L` the center orbits
embed.  The squeeze then shows that the translated centers exhaust `Γ`, which has covolume one.

## Main statements

* `SphereCeti.ZLattice.covolume_eq_one_and_relIndex_eq`: the covolume/index squeeze.

## References

* H. Cohn and N. Elkies, *New upper bounds on sphere packings I*, Annals of Mathematics 157
  (2003), 689–714, Section 8.
-/

public section

open MeasureTheory

namespace SphereCeti.ZLattice

/-- **The covolume/index squeeze.**  Let `L ≤ Γ` be full lattices with `Γ` integral.  If `L` has
covolume `N` and index at least `N` in `Γ`, then `Γ` has covolume one and `L` has index exactly
`N` in `Γ`. -/
theorem covolume_eq_one_and_relIndex_eq {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] [FiniteDimensional ℝ E] [MeasurableSpace E] [BorelSpace E]
    {L Γ : Submodule ℤ E} [DiscreteTopology L] [IsZLattice ℝ L] [DiscreteTopology Γ]
    [IsZLattice ℝ Γ] (hle : L ≤ Γ) (hΓ : ZLattice.IsIntegral Γ) {N : ℕ}
    (hcov : ZLattice.covolume L = N) (hN : N ≤ L.toAddSubgroup.relIndex Γ.toAddSubgroup) :
    ZLattice.covolume Γ = 1 ∧ L.toAddSubgroup.relIndex Γ.toAddSubgroup = N := by
  have hindex := ZLattice.covolume_div_covolume_eq_relIndex' L Γ hle
  have hΓ1 := hΓ.one_le_covolume
  have hNpos : (0 : ℝ) < N := hcov ▸ ZLattice.covolume_pos L volume
  -- The index `covol(L) / covol(Γ) = N / covol(Γ)` is at most `N`, as `covol(Γ) ≥ 1`, and at
  -- least `N` by hypothesis.
  have hle' : (L.toAddSubgroup.relIndex Γ.toAddSubgroup : ℝ) ≤ N := by
    rw [← hindex, hcov]
    exact div_le_self hNpos.le hΓ1
  have heq : (L.toAddSubgroup.relIndex Γ.toAddSubgroup : ℝ) = N :=
    le_antisymm hle' (by exact_mod_cast hN)
  refine ⟨?_, by exact_mod_cast heq⟩
  rw [← hindex, hcov, div_eq_iff (ZLattice.covolume_pos Γ volume).ne'] at heq
  nlinarith

end SphereCeti.ZLattice
