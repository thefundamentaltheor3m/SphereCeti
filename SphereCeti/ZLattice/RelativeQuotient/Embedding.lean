module

public import SphereCeti.ZLattice.RelativeQuotient

/-!
# Points incongruent modulo a lattice embed into a relative quotient

Let `Λ` and `Γ` be subgroups of an additive group `E`, and let `p : ι → E` be points that are
pairwise incongruent modulo `Λ` and whose translates `p q - x₀` by a base point `x₀` lie in `Γ`.
Then `q ↦ [p q - x₀]` is an embedding of `ι` into the quotient of `Γ` by `Λ ⊓ Γ`.  When `Λ ≤ Γ`
are full lattices in a finite-dimensional real inner product space, that quotient is finite, so
for finite `ι` the number of points is at most the index of `Λ` in `Γ`.

In the uniqueness argument of Cohn and Elkies, the points are representatives of the center
orbits of a periodic packing with period lattice `Λ`, and `Γ` is the lattice generated by the
translated centers, so the number of center orbits is at most the index of `Λ` in `Γ`.

## Main definitions

* `SphereCeti.ZLattice.relativeQuotientEmbedding`: the embedding `q ↦ [p q - x₀]` of `ι` into
  `RelativeQuotient Λ Γ`.

## Main statements

* `SphereCeti.ZLattice.relativeQuotientEmbedding_apply`: its value at `q`.
* `SphereCeti.ZLattice.card_le_relIndex`: a finite family of points incongruent modulo a full
  sublattice `Λ ≤ Γ`, with translates in `Γ`, has at most `Λ.relIndex Γ` members.

## References

* H. Cohn and N. Elkies, *New upper bounds on sphere packings I*, Annals of Mathematics 157
  (2003), 689–714, Section 8.
-/

public section

namespace SphereCeti.ZLattice

section AddCommGroup

variable {E : Type*} [AddCommGroup E] {Λ Γ : Submodule ℤ E} {ι : Type*} {p : ι → E} {x₀ : E}

/-- For points `p q` pairwise incongruent modulo `Λ` whose translates `p q - x₀` lie in `Γ`, the
embedding `q ↦ [p q - x₀]` of the index type into the quotient of `Γ` by `Λ ⊓ Γ`. -/
def relativeQuotientEmbedding (hΓ : ∀ q, p q - x₀ ∈ Γ) (hp : ∀ q q', p q - p q' ∈ Λ → q = q') :
    ι ↪ RelativeQuotient Λ Γ where
  toFun q := QuotientAddGroup.mk (⟨p q - x₀, hΓ q⟩ : Γ.toAddSubgroup)
  inj' q q' h := by
    rw [QuotientAddGroup.eq, AddSubgroup.mem_addSubgroupOf] at h
    refine (hp q' q ?_).symm
    simpa [sub_sub_sub_cancel_right] using h

/-- The embedding sends `q` to the coset of `p q - x₀`. -/
@[simp]
theorem relativeQuotientEmbedding_apply (hΓ : ∀ q, p q - x₀ ∈ Γ)
    (hp : ∀ q q', p q - p q' ∈ Λ → q = q') (q : ι) :
    relativeQuotientEmbedding hΓ hp q =
      QuotientAddGroup.mk (⟨p q - x₀, hΓ q⟩ : Γ.toAddSubgroup) :=
  (rfl)

example (hΓ : ∀ q, p q - x₀ ∈ Γ) (hp : ∀ q q', p q - p q' ∈ Λ → q = q') (q : ι) :
    relativeQuotientEmbedding hΓ hp q = 0 ↔ p q - x₀ ∈ Λ := by
  simp [AddSubgroup.mem_addSubgroupOf]

end AddCommGroup

/-- A finite family of points pairwise incongruent modulo a full sublattice `Λ ≤ Γ`, whose
translates `p q - x₀` lie in `Γ`, has at most as many members as the index of `Λ` in `Γ`. -/
theorem card_le_relIndex {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    [FiniteDimensional ℝ E] {Λ Γ : Submodule ℤ E} [DiscreteTopology Λ] [IsZLattice ℝ Λ]
    [DiscreteTopology Γ] [IsZLattice ℝ Γ] (hle : Λ ≤ Γ) {ι : Type*} [Fintype ι] {p : ι → E}
    {x₀ : E} (hΓ : ∀ q, p q - x₀ ∈ Γ) (hp : ∀ q q', p q - p q' ∈ Λ → q = q') :
    Fintype.card ι ≤ Λ.toAddSubgroup.relIndex Γ.toAddSubgroup := by
  have := finite_relativeQuotient hle
  rw [← Nat.card_eq_fintype_card]
  exact Finite.card_le_of_embedding (relativeQuotientEmbedding hΓ hp)

end SphereCeti.ZLattice
