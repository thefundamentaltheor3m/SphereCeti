module

public import SphereCeti.Lattice.IntegralPresentation

/-!
# Lattices generated by point sets with even squared distances

The `ℤ`-span of a set `S` of vectors in a real inner product space is an integral lattice exactly
when the inner product of any two points of `S` is an integer, and an even lattice exactly when,
moreover, every point of `S` has even squared norm.

If `S` contains `0` and every squared distance `‖x - y‖²` between two of its points is an even
integer, polarization, `2⟪x, y⟫ = ‖x‖² + ‖y‖² - ‖x - y‖²`, gives both conditions, so the `ℤ`-span
of `S` is an even lattice.  If `S` also spans the space over `ℝ`, its `ℤ`-span is then a discrete
full lattice; in `ℝ^d` it has an even integral presentation.  This is Lemma 8.2 of Cohn and Elkies,
which turns the centers of an optimal periodic packing into an even lattice.

## Main statements

* `SphereCeti.EuclideanLattice.isIntegral_span_iff`: the `ℤ`-span of `S` is integral exactly when
  the points of `S` have integral inner products.
* `SphereCeti.EuclideanLattice.isEven_span_iff`: the `ℤ`-span of `S` is even exactly when, moreover,
  the points of `S` have even squared norms.
* `SphereCeti.EuclideanLattice.isEven_span_of_even_sq_dist`: a set containing `0` with even integral
  squared distances spans an even lattice.
* `SphereCeti.EuclideanLattice.generatedSubmodule_evenIntegral_full`: if such a set also spans
  `ℝ^d`, its `ℤ`-span is a discrete full lattice with an even integral presentation.

## References

* H. Cohn and N. Elkies, *New upper bounds on sphere packings I*, Annals of Mathematics 157
  (2003), 689–714, Lemma 8.2.
-/

public section

open Submodule
open scoped InnerProductSpace

namespace SphereCeti.EuclideanLattice

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E] {S : Set E}

/-- The `ℤ`-span of a set is an integral lattice exactly when the inner product of any two of its
points is an integer. -/
theorem isIntegral_span_iff :
    ZLattice.IsIntegral (span ℤ S) ↔ ∀ x ∈ S, ∀ y ∈ S, ∃ m : ℤ, ⟪x, y⟫_ℝ = m := by
  rw [ZLattice.isIntegral_iff]
  refine ⟨fun h x hx y hy ↦ h x (subset_span hx) y (subset_span hy), fun h x hx y hy ↦ ?_⟩
  induction hx, hy using span_induction₂ with
  | mem_mem x y hx hy => exact h x hx y hy
  | zero_left y _ => exact ⟨0, by simp⟩
  | zero_right x _ => exact ⟨0, by simp⟩
  | add_left x₁ x₂ y _ _ _ h₁ h₂ =>
    obtain ⟨m₁, hm₁⟩ := h₁
    obtain ⟨m₂, hm₂⟩ := h₂
    exact ⟨m₁ + m₂, by rw [inner_add_left, hm₁, hm₂, Int.cast_add]⟩
  | add_right x y₁ y₂ _ _ _ h₁ h₂ =>
    obtain ⟨m₁, hm₁⟩ := h₁
    obtain ⟨m₂, hm₂⟩ := h₂
    exact ⟨m₁ + m₂, by rw [inner_add_right, hm₁, hm₂, Int.cast_add]⟩
  | smul_left c x y _ _ h =>
    obtain ⟨m, hm⟩ := h
    exact ⟨c * m, by rw [← Int.cast_smul_eq_zsmul ℝ, real_inner_smul_left, hm, Int.cast_mul]⟩
  | smul_right c x y _ _ h =>
    obtain ⟨m, hm⟩ := h
    exact ⟨c * m, by rw [← Int.cast_smul_eq_zsmul ℝ, real_inner_smul_right, hm, Int.cast_mul]⟩

/-- The `ℤ`-span of a set is an even lattice exactly when every point of the set has even
integral squared norm and the inner product of any two of its points is an integer. -/
theorem isEven_span_iff :
    ZLattice.IsEven (span ℤ S) ↔
      (∀ x ∈ S, ∃ m : ℤ, ‖x‖ ^ 2 = 2 * m) ∧ ∀ x ∈ S, ∀ y ∈ S, ∃ m : ℤ, ⟪x, y⟫_ℝ = m := by
  refine ⟨fun h ↦ ⟨fun x hx ↦ ZLattice.isEven_iff.mp h x (subset_span hx),
    isIntegral_span_iff.mp h.isIntegral⟩, fun ⟨hnorm, hinner⟩ ↦ ?_⟩
  have hint := ZLattice.isIntegral_iff.mp (isIntegral_span_iff.mpr hinner)
  refine ZLattice.isEven_iff.mpr fun x hx ↦ ?_
  induction hx using span_induction with
  | mem x hx => exact hnorm x hx
  | zero => exact ⟨0, by simp⟩
  | add x y hx hy hx' hy' =>
    obtain ⟨m, hm⟩ := hx'
    obtain ⟨n, hn⟩ := hy'
    obtain ⟨k, hk⟩ := hint x hx y hy
    exact ⟨m + n + k, by rw [norm_add_sq_real, hm, hn, hk]; push_cast; ring⟩
  | smul c x _ hx' =>
    obtain ⟨m, hm⟩ := hx'
    refine ⟨c ^ 2 * m, ?_⟩
    rw [← Int.cast_smul_eq_zsmul ℝ, norm_smul, mul_pow, hm, Real.norm_eq_abs, sq_abs]
    push_cast
    ring

/-- A set containing `0` in which every squared distance between two points is an even integer
spans an even lattice over `ℤ`. -/
theorem isEven_span_of_even_sq_dist (hzero : 0 ∈ S)
    (heven : ∀ x ∈ S, ∀ y ∈ S, ∃ n : ℤ, ‖x - y‖ ^ 2 = 2 * n) :
    ZLattice.IsEven (span ℤ S) := by
  refine isEven_span_iff.mpr ⟨fun x hx ↦ by simpa using heven x hx 0 hzero, fun x hx y hy ↦ ?_⟩
  -- Polarization: `2⟪x, y⟫ = ‖x‖² + ‖y‖² - ‖x - y‖²`.
  obtain ⟨a, ha⟩ := heven x hx 0 hzero
  obtain ⟨b, hb⟩ := heven y hy 0 hzero
  obtain ⟨c, hc⟩ := heven x hx y hy
  rw [sub_zero] at ha hb
  rw [norm_sub_sq_real] at hc
  exact ⟨a + b - c, by push_cast; linarith⟩

/-- **Cohn–Elkies, Lemma 8.2.**  A set of points of `ℝ^d` that contains `0`, spans `ℝ^d`, and in
which every squared distance between two points is an even integer generates over `ℤ` a discrete
full lattice with an even integral presentation. -/
theorem generatedSubmodule_evenIntegral_full {d : ℕ} (S : Set (EuclideanSpace ℝ (Fin d)))
    (hzero : 0 ∈ S) (hspan : span ℝ S = ⊤)
    (heven : ∀ x ∈ S, ∀ y ∈ S, ∃ n : ℤ, ‖x - y‖ ^ 2 = 2 * n) :
    ∃ (_ : DiscreteTopology (span ℤ S)) (_ : IsZLattice ℝ (span ℤ S))
      (G : IntegralPresentation (span ℤ S)), G.IsEven := by
  have hE := isEven_span_of_even_sq_dist hzero heven
  have : DiscreteTopology (span ℤ S) := hE.isIntegral.discreteTopology
  have : IsZLattice ℝ (span ℤ S) := ⟨by rw [span_span_of_tower ℤ ℝ S, hspan]⟩
  obtain ⟨G⟩ := IntegralPresentation.nonempty_of_isIntegral hE.isIntegral
  exact ⟨inferInstance, inferInstance, G, G.isEven_real_iff.mp hE⟩

end SphereCeti.EuclideanLattice
