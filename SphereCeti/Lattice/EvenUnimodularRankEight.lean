module

public import SphereCeti.Lattice.IntegralPresentation
public import TauCeti.LinearAlgebra.IntegralLattice.PosDef.SmallRankUnimodular

/-!
# Even unimodular lattices in dimension eight

Let `E` and `F` be real inner product spaces of dimension eight.  Any even unimodular lattice in
`E` is carried onto any even unimodular lattice in `F` by a linear isometry `E ≃ F`, and any coset
of the first onto any coset of the second by an affine isometry.  This is the real form of the
classification of even unimodular positive definite lattices of rank eight.  In `ℝ⁸`, the Gram
lattices of integral presentations of the two lattices are both isometric to `E₈`
(`TauCeti.IntegralLattice.IsPosDef.nonempty_isometry_typeE₈RootLattice_of_isEven`), and an
isometry of Gram lattices extends to a linear isometry of `ℝ⁸` carrying one lattice onto the
other (`SphereCeti.EuclideanLattice.IntegralPresentation.realIsometryOfIsometry`).  Orthonormal
bases identify `E` and `F` with `ℝ⁸`.

In the uniqueness of the `E₈` packing, this carries the lattice generated by the translated centers
of an optimal periodic packing, once that lattice is shown to be even unimodular, onto the `E₈`
lattice.

## Main statements

* `SphereCeti.EuclideanLattice.exists_linearIsometryEquiv_image_eq_of_even_unimodular_rank_eight`:
  a linear isometry carries one even unimodular lattice in dimension eight onto another.
* `SphereCeti.EuclideanLattice.exists_affineIsometryEquiv_maps_coset_of_even_unimodular_rank_eight`:
  an affine isometry carries a coset of one even unimodular lattice in dimension eight onto a
  coset of another.

## References

* J. H. Conway and N. J. A. Sloane, *Sphere Packings, Lattices and Groups*, 3rd ed., Springer
  (1999), Chapter 16.
-/

public section

open scoped Pointwise

namespace SphereCeti.EuclideanLattice

/-- The case of `ℝ⁸`, through integral presentations. -/
private theorem exists_linearIsometryEquiv_image_eq_euclideanSpace
    {Λ Μ : Submodule ℤ (EuclideanSpace ℝ (Fin 8))} (hΛ : ZLattice.IsEven Λ)
    (hΛu : ZLattice.IsUnimodular Λ) (hΜ : ZLattice.IsEven Μ) (hΜu : ZLattice.IsUnimodular Μ) :
    ∃ T : EuclideanSpace ℝ (Fin 8) ≃ₗᵢ[ℝ] EuclideanSpace ℝ (Fin 8),
      T '' (Λ : Set (EuclideanSpace ℝ (Fin 8))) = Μ := by
  -- Unimodular lattices are discrete and full, so they have integral presentations.
  have : DiscreteTopology Λ := hΛu.isIntegral.discreteTopology
  have : IsZLattice ℝ Λ := ⟨hΛu.span_eq_top⟩
  have : DiscreteTopology Μ := hΜu.isIntegral.discreteTopology
  have : IsZLattice ℝ Μ := ⟨hΜu.span_eq_top⟩
  obtain ⟨P⟩ := IntegralPresentation.nonempty_of_isIntegral hΛu.isIntegral
  obtain ⟨Q⟩ := IntegralPresentation.nonempty_of_isIntegral hΜu.isIntegral
  -- Both Gram lattices are isometric to `E₈`.
  obtain ⟨eP⟩ := P.isPosDef.nonempty_isometry_typeE₈RootLattice_of_isEven
    (P.isUnimodular_real_iff.mp hΛu) (P.isEven_real_iff.mp hΛ)
    (P.toIntegralLattice.finrank_carrier.trans (Module.finrank_fin_fun ℚ))
  obtain ⟨eQ⟩ := Q.isPosDef.nonempty_isometry_typeE₈RootLattice_of_isEven
    (Q.isUnimodular_real_iff.mp hΜu) (Q.isEven_real_iff.mp hΜ)
    (Q.toIntegralLattice.finrank_carrier.trans (Module.finrank_fin_fun ℚ))
  exact ⟨IntegralPresentation.realIsometryOfIsometry P Q (eP.symm.trans eQ),
    IntegralPresentation.realIsometry_maps_carrier P Q _⟩

variable {E F : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [NormedAddCommGroup F]
  [InnerProductSpace ℝ F]

/-- Let `E` and `F` be real inner product spaces of dimension eight.  Any even unimodular lattice
in `E` is carried onto any even unimodular lattice in `F` by a linear isometry `E ≃ F`. -/
theorem exists_linearIsometryEquiv_image_eq_of_even_unimodular_rank_eight
    (hE : Module.finrank ℝ E = 8) (hF : Module.finrank ℝ F = 8) {Λ : Submodule ℤ E}
    {Μ : Submodule ℤ F} (hΛ : ZLattice.IsEven Λ) (hΛu : ZLattice.IsUnimodular Λ)
    (hΜ : ZLattice.IsEven Μ) (hΜu : ZLattice.IsUnimodular Μ) :
    ∃ T : E ≃ₗᵢ[ℝ] F, T '' (Λ : Set E) = Μ := by
  have : FiniteDimensional ℝ E := Module.finite_of_finrank_pos (by omega)
  have : FiniteDimensional ℝ F := Module.finite_of_finrank_pos (by omega)
  -- Orthonormal bases identify `E` and `F` with `ℝ⁸`.
  let φ := ((stdOrthonormalBasis ℝ E).reindex (finCongr hE)).repr
  let ψ := ((stdOrthonormalBasis ℝ F).reindex (finCongr hF)).repr
  obtain ⟨T, hT⟩ := exists_linearIsometryEquiv_image_eq_euclideanSpace
    ((ZLattice.isEven_comap_iff Λ φ.symm).mpr hΛ)
    ((ZLattice.isUnimodular_comap_iff Λ φ.symm).mpr hΛu)
    ((ZLattice.isEven_comap_iff Μ ψ.symm).mpr hΜ)
    ((ZLattice.isUnimodular_comap_iff Μ ψ.symm).mpr hΜu)
  -- The corresponding lattices of `ℝ⁸` are the images `φ '' Λ` and `ψ '' Μ`.
  simp only [ZLattice.coe_comap, LinearEquiv.coe_coe, LinearIsometryEquiv.coe_toLinearEquiv,
    ← LinearIsometryEquiv.image_eq_preimage_symm] at hT
  refine ⟨φ.trans (T.trans ψ.symm), ?_⟩
  calc ⇑(φ.trans (T.trans ψ.symm)) '' (Λ : Set E) = ψ.symm '' (T '' (φ '' Λ)) := by
        simp only [LinearIsometryEquiv.coe_trans, Set.image_comp]
    _ = Μ := by rw [hT, Set.image_image]; simp

/-- Let `E` and `F` be real inner product spaces of dimension eight.  Any coset `v + Λ` of an even
unimodular lattice in `E` is carried onto any coset `w + Μ` of an even unimodular lattice in `F`
by an affine isometry `E ≃ F`. -/
theorem exists_affineIsometryEquiv_maps_coset_of_even_unimodular_rank_eight
    (hE : Module.finrank ℝ E = 8) (hF : Module.finrank ℝ F = 8) {Λ : Submodule ℤ E}
    {Μ : Submodule ℤ F} (hΛ : ZLattice.IsEven Λ) (hΛu : ZLattice.IsUnimodular Λ)
    (hΜ : ZLattice.IsEven Μ) (hΜu : ZLattice.IsUnimodular Μ) (v : E) (w : F) :
    ∃ A : E ≃ᵃⁱ[ℝ] F, A '' (v +ᵥ (Λ : Set E)) = w +ᵥ (Μ : Set F) := by
  obtain ⟨T, hT⟩ :=
    exists_linearIsometryEquiv_image_eq_of_even_unimodular_rank_eight hE hF hΛ hΛu hΜ hΜu
  refine ⟨((AffineIsometryEquiv.vaddConst ℝ v).symm.trans T.toAffineIsometryEquiv).trans
    (AffineIsometryEquiv.vaddConst ℝ w), ?_⟩
  have h : ⇑(((AffineIsometryEquiv.vaddConst ℝ v).symm.trans T.toAffineIsometryEquiv).trans
      (AffineIsometryEquiv.vaddConst ℝ w)) = fun x ↦ T (x - v) + w := by
    funext x
    simp [add_comm]
  rw [h, Set.image_sub_add_vadd_eq, hT]

end SphereCeti.EuclideanLattice
