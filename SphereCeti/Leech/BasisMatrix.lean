/-- `basisCoordinateMatrix` is lower triangular. -/
theorem basisCoordinateMatrix_isLowerTriangular : basisCoordinateMatrix.IsLowerTriangular := by
  -- `Matrix.of.symm` presents the entries as a function into `ℤ`, so that instance search
  -- finds `DecidableEq ℤ` (it does not unfold `Matrix` itself); `decide` then checks all pairs.
  have h : ∀ i j : Fin 24, i < j → Matrix.of.symm basisCoordinateMatrix i j = 0 := by
    decide
  intro i j hij
  exact h i j (OrderDual.toDual_lt_toDual.mp hij)

/-- The determinant of `basisCoordinateMatrix` is `8 ^ 12`: it is the product of the diagonal
`8, 4, 4, 4, 4, 4, 4, 2, 4, 4, 4, 2, 4, 2, 2, 2, 4, 2, 2, 2, 2, 2, 2, 1` of this lower-triangular
matrix. -/
theorem basisCoordinateMatrix_det : basisCoordinateMatrix.det = 8 ^ 12 := by
  rw [Matrix.det_of_isLowerTriangular _ basisCoordinateMatrix_isLowerTriangular]
  decide

