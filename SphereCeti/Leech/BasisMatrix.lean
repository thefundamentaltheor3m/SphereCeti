/-- The published basis matrix is lower triangular. -/
theorem basisCoordinateMatrix_isLowerTriangular : basisCoordinateMatrix.IsLowerTriangular := by
  -- `Matrix.of.symm` exposes the entries as integers, so that instance search finds
  -- `DecidableEq ℤ` (it does not unfold `Matrix` itself).
  have h : ∀ i j : Fin 24, i < j → Matrix.of.symm basisCoordinateMatrix i j = 0 := by
    decide
  intro i j hij
  exact h i j (OrderDual.toDual_lt_toDual.mp hij)

/-- Exact determinant certificate for the published integer basis matrix. -/
theorem basisCoordinateMatrix_det : basisCoordinateMatrix.det = 8 ^ 12 := by
  rw [Matrix.det_of_isLowerTriangular _ basisCoordinateMatrix_isLowerTriangular]
  decide

end SphereCeti.Leech
