/-!
# The cyclic description of the extended binary Golay code

The binary Golay code of length `23` is the cyclic code generated by the polynomial
`g = 1 + X + X^5 + X^6 + X^7 + X^9 + X^11` over `𝔽₂`.  Its parity extension is a binary code of
length `24`, spanned by the twelve rows of `golayGeneratorMatrix`: row `i` is the cyclic shift
`X^i g` on coordinates `0, …, 22`, followed by an overall parity bit in coordinate `23`.  Every
such row has weight eight, and the first twelve columns form a unitriangular matrix, so the twelve
rows are linearly independent.

TauCeti's extended binary Golay code `TauCeti.BinaryGolay.code` is instead the row space of the
systematic matrix `[I₁₂ | B]`.  The two presentations use different coordinate orders.  This file
names the coordinate relabelling `cyclicToSystematicPerm` explicitly and proves that it carries
the cyclic code onto TauCeti's code.  Consequently any coordinate statement about one presentation
(for instance a residue-class description of the Leech lattice, or a list of octads) transfers to
the other along this fixed permutation.

## Main definitions and results

* `SphereCeti.Leech.golayGeneratorMatrix`: the parity-extended cyclic generator matrix.
* `SphereCeti.Leech.golayPivotMinor`: its first twelve columns.
* `SphereCeti.Leech.cyclicGolayCode`: the row span of `golayGeneratorMatrix`.
* `SphereCeti.Leech.golayPivotMinor_unitriangular`: the pivot minor is upper unitriangular.
* `SphereCeti.Leech.golayGeneratorMatrix_rowWeight`: every generator row has weight eight.
* `SphereCeti.Leech.cyclicToSystematicPerm`: the coordinate relabelling from the cyclic order to
  the systematic order.
* `SphereCeti.Leech.map_cyclicGolayCode`: relabelling coordinates along `cyclicToSystematicPerm`
  maps `cyclicGolayCode` onto `TauCeti.BinaryGolay.code`.
* `SphereCeti.Leech.isPermutationEquivalent_cyclicGolayCode`: the two codes are permutation
  equivalent in the sense of `TauCeti.IsPermutationEquivalent`.

## Provenance

The cyclic generator polynomial is the standard one; see Conway and Sloane, *Sphere Packings,
Lattices and Groups*, 3rd ed., Springer (1999), Chapter 3.  The finite-check technique used to compare the two
coordinate presentations is adapted from TauCeti, commit
`83769e442d55cda9d85b3927a93b286831c595ff`, file
`TauCeti/LinearAlgebra/IntegralLattice/Rank24/A1TwentyFour.lean` (Apache-2.0, The Tau Ceti
contributors): the private lemma `generator_eq` is reproduced from that file up to namespace
qualification, and the two `decide +kernel` certificates (parity checks against the self-dual
systematic generator, and explicit row combinations) follow the pattern of its
`generator_mulVec_golayPrintedWord` and `sum_golayPrintedWord_golayRowCombination`.
-/

public section

namespace SphereCeti.Leech

/-- Generator matrix of the cyclic description of the extended binary Golay code.  Its first 23
columns are the first 12 shifts of `1 + X + X^5 + X^6 + X^7 + X^9 + X^11`; column 23 is the parity
extension. -/
def golayGeneratorMatrix : Matrix (Fin 12) (Fin 24) (ZMod 2) := fun i j =>
  if j.val = 23 then 1
  else if (j.val + 23 - i.val) % 23 ∈ ({0, 1, 5, 6, 7, 9, 11} : Finset ℕ) then 1
  else 0

/-- The defining formula of `golayGeneratorMatrix`. -/
theorem golayGeneratorMatrix_def : golayGeneratorMatrix = fun i j =>
    if j.val = 23 then 1
    else if (j.val + 23 - i.val) % 23 ∈ ({0, 1, 5, 6, 7, 9, 11} : Finset ℕ) then 1
    else 0 := (rfl)

/-- Entry `(i, j)` of `golayGeneratorMatrix`: `1` in the parity column `23`, and otherwise `1`
exactly when `j - i` (mod `23`) is an exponent of the generator polynomial. -/
@[simp]
theorem golayGeneratorMatrix_apply (i : Fin 12) (j : Fin 24) :
    golayGeneratorMatrix i j =
      if j.val = 23 then 1
      else if (j.val + 23 - i.val) % 23 ∈ ({0, 1, 5, 6, 7, 9, 11} : Finset ℕ) then 1
      else 0 := (rfl)

example : golayGeneratorMatrix 3 8 = 1 := by simp

/-- The first twelve columns of `golayGeneratorMatrix`. -/
def golayPivotMinor : Matrix (Fin 12) (Fin 12) (ZMod 2) := fun i j =>
  golayGeneratorMatrix i ⟨j.val, by omega⟩

/-- `golayPivotMinor` is `golayGeneratorMatrix` restricted to the first twelve columns. -/
theorem golayPivotMinor_def :
    golayPivotMinor = fun i j => golayGeneratorMatrix i (Fin.castLE (by norm_num) j) := (rfl)

/-- Entry `(i, j)` of `golayPivotMinor` is entry `(i, j)` of `golayGeneratorMatrix`. -/
@[simp]
theorem golayPivotMinor_apply (i j : Fin 12) :
    golayPivotMinor i j = golayGeneratorMatrix i (Fin.castLE (by norm_num) j) := (rfl)

example : golayPivotMinor 2 2 = 1 := by simp

/-- The pivot minor `golayPivotMinor` is upper unitriangular: its entries below the diagonal
vanish and its diagonal entries equal one. -/
theorem golayPivotMinor_unitriangular :
    (∀ i j : Fin 12, j < i → golayPivotMinor i j = 0) ∧
      ∀ i : Fin 12, golayPivotMinor i i = 1 := by
  -- A finite check: each of the `12 × 12` entries is evaluated by `decide`.
  constructor
  · intro i j hji
    fin_cases i <;> fin_cases j <;> norm_num at hji <;> decide
  · intro i
    fin_cases i <;> decide

/-- Every row of `golayGeneratorMatrix`, a parity-extended shift of the generator polynomial, has
Hamming weight eight. -/
theorem golayGeneratorMatrix_rowWeight :
    ∀ i : Fin 12, hammingNorm (golayGeneratorMatrix i) = 8 := by
  -- A finite check: the weight of each of the twelve rows is evaluated by `decide`.
  intro i
  fin_cases i <;> decide

/-- The cyclic description of the extended binary Golay code: the row span of the cyclic
generator matrix.  It is not TauCeti's `BinaryGolay.code`, which uses other coordinates. -/
noncomputable def cyclicGolayCode : Submodule (ZMod 2) (Fin 24 → ZMod 2) :=
  Submodule.span (ZMod 2) (Set.range fun i => golayGeneratorMatrix i)

/-- `cyclicGolayCode` is the span of the rows of `golayGeneratorMatrix`. -/
theorem cyclicGolayCode_def :
    cyclicGolayCode = Submodule.span (ZMod 2) (Set.range fun i => golayGeneratorMatrix i) :=
  (rfl)

/-- `cyclicGolayCode` is the code generated by `golayGeneratorMatrix`, in TauCeti's sense. -/
theorem cyclicGolayCode_eq_generatedBy : cyclicGolayCode = golayGeneratorMatrix.generatedBy := by
  rw [Matrix.generatedBy_eq_span_rows, cyclicGolayCode_def]
  rfl

/-! ### The coordinate permutation -/

/-- The coordinate relabelling from the cyclic order to the systematic order of
`TauCeti.BinaryGolay.code`: cyclic coordinate `p` becomes systematic coordinate
`cyclicToSystematicPerm p`, so systematic coordinate `j` of a relabelled word is its cyclic
coordinate `cyclicToSystematicPerm.symm j`. -/
def cyclicToSystematicPerm : Equiv.Perm (Fin 24) where
  toFun := ![0, 1, 2, 3, 4, 5, 8, 13, 12, 9, 11, 22, 10, 19, 20, 21, 15, 17, 18, 14, 23, 7, 6, 16]
  invFun := ![0, 1, 2, 3, 4, 5, 22, 21, 6, 9, 12, 10, 8, 7, 19, 16, 23, 17, 18, 13, 14, 15, 11, 20]
  left_inv := by decide
  right_inv := by decide

/-- The values of `cyclicToSystematicPerm`, as a table indexed by the cyclic coordinate. -/
@[simp]
theorem cyclicToSystematicPerm_apply (p : Fin 24) :
    cyclicToSystematicPerm p =
      ![0, 1, 2, 3, 4, 5, 8, 13, 12, 9, 11, 22, 10, 19, 20, 21, 15, 17, 18, 14, 23, 7, 6, 16] p :=
  (rfl)

example : cyclicToSystematicPerm 6 = 8 := by simp

/-- The values of the inverse of `cyclicToSystematicPerm`, as a table indexed by the systematic
coordinate. -/
@[simp]
theorem cyclicToSystematicPerm_symm_apply (j : Fin 24) :
    cyclicToSystematicPerm.symm j =
      ![0, 1, 2, 3, 4, 5, 22, 21, 6, 9, 12, 10, 8, 7, 19, 16, 23, 17, 18, 13, 14, 15, 11, 20] j :=
  (rfl)

example : cyclicToSystematicPerm.symm 8 = 6 := by simp

/-- A cyclic generator row, relabelled into the systematic coordinate order. -/
private def relabelledRow (i : Fin 12) : Fin 24 → ZMod 2 :=
  fun j => golayGeneratorMatrix i (cyclicToSystematicPerm.symm j)

/-- The systematic Golay generator with its entries written out, so that the kernel can evaluate
it: the body of `TauCeti.BinaryGolay.block` is not exposed outside its module. -/
private theorem generator_eq : TauCeti.BinaryGolay.generator = fun i ↦
    Fin.append ((1 : Matrix (Fin 12) (Fin 12) (ZMod 2)) i) fun j : Fin 12 ↦
      if i = 0 then (if j = 0 then 0 else 1) else if j = 0 then 1 else
        if (i.val + j.val - 2) % 11 ∈ ({0, 1, 3, 4, 5, 9} : Finset ℕ) then 1 else 0 := by
  rw [TauCeti.BinaryGolay.generator_def]
  funext i
  congr 1
  funext j
  exact TauCeti.BinaryGolay.block_apply i j

/-- Every relabelled cyclic row passes the parity checks of the self-dual systematic generator. -/
private theorem generator_mulVec_relabelledRow :
    ∀ i, TauCeti.BinaryGolay.generator.mulVec (relabelledRow i) = 0 := by
  rw [generator_eq]
  refine fun i ↦ funext fun k ↦ ?_
  revert i k
  decide +kernel

/-- For each systematic generator row, the relabelled cyclic rows whose sum is that row. -/
private def systematicRowCombination : Fin 12 → List (Fin 12) :=
  ![[0, 1, 2, 3, 4, 8, 9], [1, 2, 3, 4, 5, 7, 8], [2, 3, 4, 5, 6, 7, 9], [3, 4, 5, 6, 7, 8, 9],
    [4, 5, 6, 8], [5, 6, 8, 9], [7, 11], [8, 9, 10], [6, 7], [8], [7], [8, 9]]

/-- Each systematic generator row is a sum of relabelled cyclic rows. -/
private theorem sum_relabelledRow_systematicRowCombination :
    ∀ k, ((systematicRowCombination k).map relabelledRow).sum =
      TauCeti.BinaryGolay.generator k := by
  rw [generator_eq]
  refine fun k ↦ funext fun j ↦ ?_
  revert k j
  decide +kernel

/-- The relabelling map, applied to a cyclic generator row. -/
private theorem funCongrLeft_golayGeneratorMatrix (i : Fin 12) :
    LinearEquiv.funCongrLeft (ZMod 2) (ZMod 2) cyclicToSystematicPerm.symm
      (golayGeneratorMatrix i) = relabelledRow i :=
  funext fun _ ↦ LinearMap.funLeft_apply _ _ _ _ _

/-- Relabelling coordinates along `cyclicToSystematicPerm` maps the cyclic Golay code onto
TauCeti's extended binary Golay code `TauCeti.BinaryGolay.code`. -/
theorem map_cyclicGolayCode :
    cyclicGolayCode.map
        (LinearEquiv.funCongrLeft (ZMod 2) (ZMod 2) cyclicToSystematicPerm.symm :
          (Fin 24 → ZMod 2) →ₗ[ZMod 2] (Fin 24 → ZMod 2)) =
      TauCeti.BinaryGolay.code := by
  -- Both inclusions are finite checks, so no dimension count is needed.  Every relabelled cyclic
  -- row satisfies the parity checks of the self-dual systematic generator, and every systematic
  -- generator row is an explicit sum of relabelled cyclic rows.
  apply le_antisymm
  · rw [Submodule.map_le_iff_le_comap, cyclicGolayCode_eq_generatedBy, Matrix.generatedBy_le_iff]
    intro i
    rw [Matrix.row, Submodule.mem_comap, LinearEquiv.coe_coe, funCongrLeft_golayGeneratorMatrix,
      ← TauCeti.BinaryGolay.checkedBy_generator, Matrix.mem_checkedBy_iff]
    exact generator_mulVec_relabelledRow i
  · rw [TauCeti.BinaryGolay.code_def, Matrix.generatedBy_le_iff]
    intro k
    rw [Matrix.row, ← sum_relabelledRow_systematicRowCombination k]
    refine list_sum_mem fun y hy ↦ ?_
    obtain ⟨i, -, rfl⟩ := List.mem_map.mp hy
    rw [← funCongrLeft_golayGeneratorMatrix]
    refine Submodule.mem_map_of_mem ?_
    rw [cyclicGolayCode_eq_generatedBy]
    exact Matrix.row_mem_generatedBy golayGeneratorMatrix i

/-- The cyclic code is TauCeti's code after a coordinate permutation, in TauCeti's sense of
permutation equivalence. -/
theorem isPermutationEquivalent_cyclicGolayCode :
    TauCeti.IsPermutationEquivalent cyclicGolayCode TauCeti.BinaryGolay.code :=
  TauCeti.isPermutationEquivalent_iff.mpr ⟨cyclicToSystematicPerm, map_cyclicGolayCode⟩

end SphereCeti.Leech
