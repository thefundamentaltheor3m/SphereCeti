module

public import Mathlib.Analysis.Normed.Group.Submodule

/-!
# Submodules inside the translates of a separated set

Let `X` be a set in a seminormed additive group whose distinct points are at distance at least
`r`, and let `x₀ ∈ X`.  If every vector of a submodule `Γ` is a translate `x - x₀` of a point
`x ∈ X`, then every nonzero vector of `Γ` has norm at least `r`.

In the uniqueness argument of Cohn and Elkies, `X` is the center set of an optimal periodic
packing with center separation `r` and `Γ` is the lattice generated by the translated centers;
once the translated centers are all of `Γ`, every nonzero vector of `Γ` has norm at least `r`.

## Main statements

* `Submodule.le_norm_of_subset_image_sub`: every nonzero vector of a submodule contained in the
  translates of an `r`-separated set has norm at least `r`.

## References

* H. Cohn and N. Elkies, *New upper bounds on sphere packings I*, Annals of Mathematics 157
  (2003), 689–714, Section 8.
-/

public section

namespace Submodule

/-- If every vector of a submodule `Γ` is a translate `x - x₀` of a point of a set `X`, with
`x₀ ∈ X`, and distinct points of `X` are at distance at least `r`, then every nonzero vector of
`Γ` has norm at least `r`. -/
theorem le_norm_of_subset_image_sub {R E : Type*} [Ring R] [SeminormedAddCommGroup E]
    [Module R E] {Γ : Submodule R E} {X : Set E} {x₀ : E} {r : ℝ} (hx₀ : x₀ ∈ X)
    (hsep : ∀ x ∈ X, ∀ y ∈ X, x ≠ y → r ≤ dist x y)
    (hX : (Γ : Set E) ⊆ (fun x ↦ x - x₀) '' X) (γ : Γ) (hγ : γ ≠ 0) : r ≤ ‖(γ : E)‖ := by
  obtain ⟨x, hx, hxγ⟩ := hX γ.2
  rw [← hxγ, ← dist_eq_norm]
  exact hsep x hx x₀ hx₀ fun h ↦ hγ (Submodule.coe_eq_zero.mp (by simpa [h] using hxγ.symm))

end Submodule
