module

public import Mathlib.Analysis.Normed.Group.Basic

/-!
# Sets inside the translates of a separated set

Let `X` be a set in a seminormed additive group whose distinct points are at distance at least
`r`, and let `x₀ ∈ X`.  If every vector of a set `Y` is a translate `x - x₀` of a point `x ∈ X`,
then every nonzero vector of `Y` has norm at least `r`.

In the uniqueness argument of Cohn and Elkies, `X` is the center set of an optimal periodic
packing with center separation `r` and `Y` is the lattice generated by the translated centers;
once the translated centers are all of that lattice, every nonzero lattice vector has norm at
least `r`.

## Main statements

* `Set.le_norm_of_subset_image_sub`: every nonzero vector of a set contained in the translates of
  an `r`-separated set has norm at least `r`.

## References

* H. Cohn and N. Elkies, *New upper bounds on sphere packings I*, Annals of Mathematics 157
  (2003), 689–714, Section 8.
-/

public section

namespace Set

/-- If every vector of a set `Y` is a translate `x - x₀` of a point of a set `X`, with `x₀ ∈ X`,
and distinct points of `X` are at distance at least `r`, then every nonzero vector of `Y` has norm
at least `r`. -/
theorem le_norm_of_subset_image_sub {E : Type*} [SeminormedAddCommGroup E] {X Y : Set E} {x₀ : E}
    {r : ℝ} (hx₀ : x₀ ∈ X) (hsep : ∀ x ∈ X, ∀ y ∈ X, x ≠ y → r ≤ dist x y)
    (hX : Y ⊆ (fun x ↦ x - x₀) '' X) {γ : E} (hγ : γ ∈ Y) (hne : γ ≠ 0) : r ≤ ‖γ‖ := by
  obtain ⟨x, hx, rfl⟩ := hX hγ
  rw [← dist_eq_norm]
  exact hsep x hx x₀ hx₀ fun h ↦ hne (sub_eq_zero.mpr h)

end Set
